{
  "manifest_version": 3,
  "name": "Session Afterlife",
  "version": "0.1.0",
  "description": "Checks whether an old session still works after logout, password change or timeout, and audits session cookies. For authorized testing only.",
  "minimum_chrome_version": "116",
  "permissions": [
    "cookies",
    "storage",
    "webRequest",
    "declarativeNetRequestWithHostAccess",
    "alarms",
    "notifications",
    "sidePanel",
    "activeTab"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Session Afterlife",
    "default_icon": {
      "16": "icons/off-16.png",
      "32": "icons/off-32.png",
      "48": "icons/off-48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "host_permissions": [
    "*://localhost/*",
    "*://127.0.0.1/*"
  ]
}
