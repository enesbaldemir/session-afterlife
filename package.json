{
  "name": "session-afterlife",
  "version": "0.1.0",
  "private": true,
  "description": "Browser extension that checks whether an old session still works after logout, password change or timeout.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "demo": "node demo/server.js",
    "demo:flawed": "node demo/server.js --flaws logout,password,jwt,fixation,weak-cookie,cache --idle 300",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/*.test.js\"",
    "pack": "node scripts/pack.js"
  }
}
